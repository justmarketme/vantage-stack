{
  "brand": {
    "name": "van-tij-stack",
    "positioning": "Premium, world-class, system-led growth partner"
  },
  "colors": {
    "background": "#0B0B0C",
    "surface": "#1A1A1D",
    "accent": "#3B82F6",
    "textPrimary": "#F8F9FA",
    "textMuted": "#9CA3AF"
  },
  "typography": {
    "fontFamily": {
      "heading": ["Space Grotesk", "system-ui", "sans-serif"],
      "body": ["Inter", "system-ui", "sans-serif"]
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    }
  },
  "radius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "pill": "9999px"
  },
  "motion": {
    "easing": {
      "premium": [0.16, 1, 0.3, 1]
    },
    "durationMs": {
      "fast": 180,
      "base": 320,
      "slow": 600
    }
  },
  "accessibility": {
    "minTapTargetPx": 44,
    "focusVisibleRequired": true
  },
  "componentLibrary": {
    "root": "components",
    "preferredSubdir": "components/ui"
  }
}

