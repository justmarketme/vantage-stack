################################################################################
# Core (required by secrets-manager + app bootstrap)
################################################################################

# Supabase Postgres connection string (Service role / DB user)
# Example host pattern: db.<project-ref>.supabase.co
DATABASE_URL=postgresql://user:pass@db.your-project-ref.supabase.co:5432/postgres
# Optional: skip auto-probe and force session pooler region (Supabase → Database → Connection pooling).
# SUPABASE_POOLER_REGION=eu-central-1
# Optional: disable rewriting direct db.*.supabase.co to the IPv4 session pooler (not recommended on Windows).
# SUPABASE_DISABLE_AUTO_POOLER=1

# Supabase anon key (public client key; used for REST auth checks)
SUPABASE_KEY=your_supabase_anon_key

# Eleven Labs API key (spelled per VantageStack env contract)
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key

################################################################################
# Isabel (ElevenLabs Conversational AI)
################################################################################

# Create an agent at https://elevenlabs.io/app/conversational-ai and paste the ID here
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here

# Back-compat (older scripts may read this name). Prefer ELEVEN_LABS_API_KEY.
ELEVENLABS_API_KEY=your_eleven_labs_api_key

################################################################################
# Design system viewer (optional)
################################################################################

# Set to 1 to expose /design-system in production. In development the page is always available.
# NEXT_PUBLIC_DESIGN_SYSTEM_VIEWER=1

################################################################################
# Storage/report generation (optional, depending on which MCPs you run)
################################################################################

# Used by mcp/report-generator (Agent 3) to write onboarding reports into the `reports` table
REPORTS_PG_URL=postgresql://user:pass@host:5432/dbname

################################################################################
# Agent 2 (Research Orchestrator) free-only signals + keys
################################################################################

# Tranco (traffic/popularity rank) is fetched from public Tranco API; no key required.

# OpenPageRank (optional; free-tier key provides an authority-like score)
OPENPAGERANK_API_KEY=your_openpagerank_api_key_here

# Whois gateway/provider (recommended: point at a WHOIS API provider you chose)
WHOIS_BASE_URL=https://your-whois-provider.example.com
WHOIS_API_KEY=your_whois_key

# Google PageSpeed Insights API key (optional but recommended to avoid quota issues)
PAGESPEED_API_KEY=your_google_pagespeed_key

# Legacy (paid) providers — disabled in free-only mode. Keep blank.
# SIMILARWEB_BASE_URL=
# SIMILARWEB_API_KEY=
# SEMRUSH_BASE_URL=
# SEMRUSH_API_KEY=

# Morning Briefing Generator (MCP / script)
BRIEFING_PG_URL=postgres://user:pass@host:5432/dbname
BRIEFING_TIMEZONE=Africa/Johannesburg

# Optional: override SQL per section (use $1/$2/$3 for since/until/timezone)
# BRIEFING_SQL_NEW_LEADS=
# BRIEFING_SQL_AT_RISK_CLIENTS=
# BRIEFING_SQL_UPSELL_OPPORTUNITIES=
# BRIEFING_SQL_TASKS_DUE_TODAY=
# BRIEFING_SQL_SYSTEM_ERRORS=

################################################################################
# Telegram delivery
# Optional for local bootstrap (check-env does not require this). Required when running
# telegram-orchestrator, morning-briefing Telegram, etc. Free token from @BotFather.
################################################################################

TELEGRAM_BOT_TOKEN=123456:abcDEF-your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789

# Telegram bot orchestrator (scripts/telegram-bot.ts)
# Uses Postgres like briefing-generator; defaults to DATABASE_URL when not set.
TELEGRAM_PG_URL=postgres://user:pass@host:5432/dbname

# Optional: override SQL per command (use $1 as ISO date like 2026-03-18)
# TELEGRAM_SQL_TODAYS_BLUEPRINTS=
# TELEGRAM_SQL_RED_FLAG_REPORTS=
# TELEGRAM_SQL_PENDING_UPSELLS=
# TELEGRAM_SQL_TASKS_DUE_TODAY=
# TELEGRAM_SQL_CLIENT_BY_NAME=
# TELEGRAM_SQL_LATEST_REPORT_FOR_CLIENT=
# TELEGRAM_SQL_PIPELINE_COUNTS=
# TELEGRAM_SQL_LEADS_TODAY=
# TELEGRAM_SQL_REVENUE_MTD=
# TELEGRAM_SQL_MRR=
# TELEGRAM_SQL_PIPELINE_VALUE=

# /trigger-report behavior:
# - queue: write a task record to data/telegram-orchestrator-task-queue.json
# - noop: just acknowledge (useful while wiring Agent 2)
TELEGRAM_TRIGGER_REPORT_MODE=queue

# Competitive intelligence (News API)
# Used to scan competitor/industry mentions in the last 24h.
BRIEFING_NEWS_API_KEY=your_newsapi_key
# Optional: override endpoint (default uses https://newsapi.org/v2/everything)
# BRIEFING_NEWS_API_ENDPOINT=https://newsapi.org/v2/everything

# Optional: SQL hooks for competitive briefing (recommended to set these)
# BRIEFING_SQL_ACTIVE_CLIENTS=select id::text, name::text, industry::text, competitors::jsonb from clients where status='active'
# BRIEFING_SQL_CLIENT_WEEKLY_METRICS=select client_id::text, traffic::float8, conversions::float8, cost_per_lead::float8, avg_7d_traffic::float8, avg_7d_conversions::float8, avg_7d_cpl::float8 from client_weekly_metrics

# Public app URL (used for open-tracking pixel links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public main website URL (optional; if unset, uptime-check falls back to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SITE_URL=

# Resend (email delivery)
# RESEND_API_KEY from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Verified sender address in Resend (e.g. reports@yourdomain.com)
RESEND_FROM_EMAIL=reports@yourdomain.com

# Twilio (WhatsApp delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# e.g. whatsapp:+14155238886 (Twilio sandbox or approved sender)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

################################################################################
# Monitoring & Alerts (Sentry + Telegram + health checks)
################################################################################

# Sentry DSN (server + client, used by @sentry/nextjs)
SENTRY_DSN=
# Optional: publish DSN to client (if you want frontend error tracking)
NEXT_PUBLIC_SENTRY_DSN=
# Optional sampling for performance tracing (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry API access (for daily digest to Telegram)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Base URL for internal dashboard fetches
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Telegram bot heartbeat freshness window (used by `/api/monitoring/telegram-heartbeat`)
# Default is 5 minutes.
TELEGRAM_HEARTBEAT_MAX_AGE_MS=300000

# Delivery DB + internal notifications
# Postgres URL for delivery updates (reuses WEEKLY_PG_URL/BRIEFING_PG_URL if DELIVERY_PG_URL not set)
DELIVERY_PG_URL=
# Table name to update (must be a simple identifier). Default: reports
DELIVERY_REPORTS_TABLE=reports
# Internal webhook to notify after delivery attempt
INTERNAL_DELIVERY_WEBHOOK_URL=

################################################################################
# Weekly report automation (weekly-scheduler)
################################################################################
# Vercel cron route protection
CRON_SECRET=replace_with_a_long_random_string

# Agent webhooks (used by weekly-scheduler pipeline)
# - Research batch cron calls Agent 2 research webhook
# - Weekly reports cron calls Agent 5 delivery webhook
RESEARCH_AGENT_WEBHOOK_URL=
DELIVERY_AGENT_WEBHOOK_URL=
REPORT_AGENT_WEBHOOK_URL=
VIDEO_AGENT_WEBHOOK_URL=

# API CORS allowlist for agent endpoints (comma-separated).
# For now, localhost frontend only; update to your production domain when live.
CORS_ORIGINS=http://localhost:3000

# Optional: dedicated scheduler Postgres URL for cron execution logs + job runs.
# If unset, scheduler-engine will reuse WEEKLY_PG_URL/BRIEFING_PG_URL/REPORTS_PG_URL (where available).
SCHEDULER_PG_URL=
# Weekly Postgres URL (optional; otherwise BRIEFING_PG_URL is reused)
# WEEKLY_PG_URL=postgres://user:pass@host:5432/dbname
# Resend (weekly email delivery)
# RESEND_API_KEY and RESEND_FROM_EMAIL are already used by delivery-coordinator

# Optional SQL overrides if your schema differs
# WEEKLY_SQL_ACTIVE_CLIENTS=
# WEEKLY_SQL_WEEKLY_METRICS=
# WEEKLY_SQL_TRAFFIC_TREND=

# Telegram bot (telegram-orchestrator MCP)
# Optional default destination chat ID (can also be passed per-message).
TELEGRAM_DEFAULT_CHAT_ID=your_default_chat_id_here

# Optional: dedicated CEO coach chat id for strategic SOP recommendations.
TELEGRAM_CEO_COACH_CHAT_ID=

################################################################################
# Apify (automation / scraping)
################################################################################

APIFY_TOKEN=your_apify_token_here

################################################################################
# Notion (SOP documentation + optimization backlog)
################################################################################
NOTION_API_TOKEN=your_notion_v2_token_here
# Easiest: paste the full browser URL of the parent page (e.g. Vantage stack SOP's).
NOTION_PARENT_PAGE_URL=
# Or set UUID only (leave NOTION_PARENT_PAGE_URL empty if you use this).
NOTION_ROOT_PARENT_PAGE_ID=
NOTION_VERSION=2022-06-28

################################################################################
# SOP Generator (Supabase / Postgres)
################################################################################
# Same connection is used by /crm → SOPs (in-app edit). Falls back to DATABASE_URL etc. if empty.
SOP_PG_URL=

################################################################################
# Internal admin (/admin) — not linked publicly; use strong values in production
################################################################################
# Password for /admin/login (plain text; store only in env / secret manager)
CRM_ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (32+ random bytes recommended).
# If unset, CRON_SECRET is used as a fallback (dev only — prefer a dedicated value).
ADMIN_SESSION_SECRET=

################################################################################
# Avatar generator MCP (Agent: explainer avatar video)
################################################################################
# ElevenLabs: full MP4 when your account exposes a compatible HTTP endpoint:
# POST body: { script, voice_id, avatar_id, video_format, background }
ELEVENLABS_AVATAR_VIDEO_URL=
# Optional: professional female voice (override Rachel default). South African voice ID if available.
ELEVENLABS_AVATAR_VOICE_ID=
# Optional: avatar asset id from ElevenLabs when required by your video endpoint
ELEVENLABS_AVATAR_ID=
# Supabase Storage (server-side upload)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Bucket name; objects stored as {client_id}/avatar_video_{timestamp}.mp4
SUPABASE_REPORTS_BUCKET=reports
# Optional: POST JSON when draft is ready for human review
CRM_AVATAR_NOTIFICATION_WEBHOOK_URL=
